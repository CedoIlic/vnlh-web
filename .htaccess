# ─── Jedina zamjena za paljenje/gašenje javne blokade održavanja ───
# PALI (blokiraj sve osim pravila dolje — localhost, maintenance.html …): UKLONI „#“ s REDA koji počinje „SetEnvIf“.
# GAŠENJE javne blokade: dodaj ponovno jedan „#“ SAMO ISPRED TE LINIJE „SetEnvIf“ (bez diranja pravila dolje).
<IfModule mod_setenvif.c>
#SetEnvIf Request_URI ".*" VNLH_MAINT=1
</IfModule>

# Ulaz: prvo prijava (php/Login.php); index.php = početna nakon prijave; index.html → index.php.
DirectoryIndex php/Login.php

# --- Točka 6: Zabrana listinga direktorija ---
Options -Indexes

# --- Točka 5: Sigurnosni HTTP headeri ---
<IfModule mod_headers.c>
    # Zabrana umetanja u iframe (clickjacking zaštita)
    Header always set X-Frame-Options "DENY"
    # Browser ne smije "pogađati" MIME tip odgovora
    Header always set X-Content-Type-Options "nosniff"
    # Referrer: šalje samo origin, bez punog URL-a, samo na HTTPS
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: uključiti tek nakon što potvrdiš da HTTPS radi ispravno na serveru.
    # Kad potvrdiš, ukloni # na sljedećoj liniji.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Stranica održavanja: bez keša u pregledniku (nakon gašenja maint-a korisnik ne bi smio vidjeti stari HTML za zalogaj „Natrag”).
<Files "maintenance.html">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Točka 4: HTTPS redirect (produkcija) ---
    # Preskače localhost i 127.0.0.1 da lokalni razvoj i dalje radi na HTTP.
    # X-Forwarded-Proto: https – za reverse proxy / Cloudflare Tunnel (origin vidi HTTP, klijent HTTPS).
    # Opcijski izuzetak Host *.trycloudflare.com – odkomentiraj ako tunel i dalje daje ERR_TOO_MANY_REDIRECTS
    # a X-Forwarded-Proto ne dolazi do Apachea; za produkciju bez tunela ostavi zakomentirano.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    # RewriteCond %{HTTP_HOST} !trycloudflare\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Održavanje (MAINT): uključeno ako je POSTAVLJENA varijabla VNLH_MAINT (SetEnvIf na početku fajla).
    # Ne treba bazu — šalje korisnika na jedinstvenu stranicu održavanja.
    # Vanjski redirect (302): preglednik inače kešira odgovor pod PRVOTNIM URL-om (npr. php/Login.php) i po gašenju
    # maint-a još prikazuje stari HTML dok ne Ctrl+Shift+R; s redirectom keš vrijedi za /vnlh/maintenance.html, ne za Login.php.
    # Za https://digital.hr/vnlh/... vrijedi REQUEST_URI s prefiksom /vnlh/ (document root = public_html).
    # Istim uvjetima kao HTTPS redirect iznad — localhost i 127.0.0.1 ne ulaze u maint (prilagodi ako dev okruženje ima drugi Host).
    # .well-known: izuzimanje ako ACME ili hosting koristi /vnlh/.well-known/ ili /.well-known/ ispod dokument roota.
    #
    # Whitelist (REMOTE_ADDR — tvoj javni ISP IP kad si na produkciji): odkomentiraj sljedeći RewriteCond i u zagradi dodaj jedan
    # ili više IP-ova u obliku ( ^a\.b\.c\.d$ |^w\.x\.y\.z$ ) — sve znakove točaka escapati kao \.
    #
    RewriteCond %{ENV:VNLH_MAINT} =1
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
    RewriteCond %{REQUEST_URI} !/maintenance\.html$
    RewriteCond %{REQUEST_URI} !^/.well-known/
    RewriteCond %{REQUEST_URI} !^/vnlh/\.well-known/
    # Whitelist kad testirate jedan ili više IP-ova na produkciji (zadnji blok uvjeta prije pravila dolje mora ispuniti se za blokadu):
    # RewriteCond %{REMOTE_ADDR} !(^203\.0\.113\.79$|^198\.51\.100\.42$)
    RewriteRule .* /vnlh/maintenance.html [R=302,L]

    # Generički router: php/X.php → html_router.php?page=X kad X.php ne postoji a html/X.html postoji.
    # Pokriva nove stranice bez individualnog PHP wrappera; html_router.php provjerava postoji li html/X.html.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^php/([A-Za-z0-9_-]+)\.php$ php/html_router.php?page=$1 [L,QSA,NC]

    # Stari bookmarki / linkovi na html/*.php → php/ (PHP je samo u php/; html/ je samo .html)
    RewriteRule ^html/([^/]+\.php)$ php/$1 [L,R=301]

    # html/...html: ako to NIJE stvarna datoteka (pogrešan .html uz ime php endpointa), preusmjeri na php/...php.
    # Pokriva sve takve slučajeve; stvarni html/Clanovi_CRUD.html itd. ostaju (REQUEST_FILENAME postoji).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^html/(.+)\.html$ php/$1.php [L,R=301,QSA,NC]

    # U php/ ne postoje .html datoteke – bilo koji php/...html → ...php
    RewriteRule ^php/(.+)\.html$ php/$1.php [L,R=301,QSA,NC]

    # index u korijenu prije općeg ...html → php (da se index.html ne mapira na php/index.php)
    RewriteRule ^index\.html$ index.php [L,R=302]

    # Jedan segment ...html u korijenu (nije datoteka/mapa) → php/...php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)\.html$ php/$1.php [L,R=301,QSA,NC]
</IfModule>
